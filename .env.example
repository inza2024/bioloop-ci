# Backend (defaults already work from the repository root)
BIOLOOP_DB_PATH=data/local/bioloop.db
BIOLOOP_EVIDENCE_DIR=data/local/evidence
BIOLOOP_WEB_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///data/local/bioloop.db
BIOLOOP_COOKIE_SECURE=false
BIOLOOP_SESSION_TTL_SECONDS=28800
BIOLOOP_DEMO_IDENTITIES_ENABLED=true
BIOLOOP_SYNTHETIC_PROFILE=small
# Les invitations sensibles sont locales, sans email ; leur durée est fournie
# à l'API et bornée entre 1 et 168 heures (24 h dans l'interface de démo).

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
